declare(strict_types=1);

namespace App\Tests\Domain\Service;

use App\Domain\Entity\FriendRequest;
use App\Domain\Entity\FriendRequestStatus;
use App\Domain\Repository\FriendRequestRepositoryInterface;
use App\Domain\Service\FriendshipService;
use PHPUnit\Framework\MockObject\MockObject;
use PHPUnit\Framework\TestCase;
use PHPUnit\Framework\Attributes\DataProvider;

class FriendshipServiceTest extends TestCase
{
    private FriendRequestRepositoryInterface&MockObject $friendRequestRepository;
    private FriendshipService $friendshipService;

    protected function setUp(): void
    {
        $this->friendRequestRepository = $this->createMock(FriendRequestRepositoryInterface::class);
        $this->friendshipService = new FriendshipService($this->friendRequestRepository);
    }

    public function testSendFriendRequestSuccess(): void
    {
        $senderId = 'user1';
        $receiverId = 'user2';

        $this->friendRequestRepository->method('findBySenderId')
            ->with($senderId)
            ->willReturn([]);

        $this->friendRequestRepository->method('findBySenderId')
            ->with($receiverId)
            ->willReturn([]);

        $this->friendRequestRepository->expects($this->once())
            ->method('save')
            ->with($this->isInstanceOf(FriendRequest::class));

        $result = $this->friendshipService->sendFriendRequest($senderId, $receiverId);

        $this->assertInstanceOf(FriendRequest::class, $result);
        $this->assertSame($senderId, $result->getSenderId());
        $this->assertSame($receiverId, $result->getReceiverId());
        $this->assertSame(FriendRequestStatus::PENDING, $result->getStatus());
    }

    public function testSendFriendRequestAlreadySent(): void
    {
        $senderId = 'user1';
        $receiverId = 'user2';

        $existingRequest = new FriendRequest(
            id: 'fr_existing',
            senderId: $senderId,
            receiverId: $receiverId,
            status: FriendRequestStatus::PENDING,
            createdAt: new \DateTimeImmutable()
        );

        $this->friendRequestRepository->method('findBySenderId')
            ->with($senderId)
            ->willReturn([$existingRequest]);

        $this->expectException(\RuntimeException::class);
        $this->expectExceptionMessage('Friend request already sent');

        $this->friendshipService->sendFriendRequest($senderId, $receiverId);
    }

    public function testSendFriendRequestAlreadyReceived(): void
    {
        $senderId = 'user1';
        $receiverId = 'user2';

        $existingRequest = new FriendRequest(
            id: 'fr_existing',
            senderId: $receiverId,
            receiverId: $senderId,
            status: FriendRequestStatus::PENDING,
            createdAt: new \DateTimeImmutable()
        );

        $this->friendRequestRepository->method('findBySenderId')
            ->with($senderId)
            ->willReturn([]);

        $this->friendRequestRepository->method('findBySenderId')
            ->with($receiverId)
            ->willReturn([$existingRequest]);

        $this->expectException(\RuntimeException::class);
        $this->expectExceptionMessage('Friend request already received from this user');

        $this->friendshipService->sendFriendRequest($senderId, $receiverId);
    }

    public function testAcceptFriendRequestSuccess(): void
    {
        $requestId = 'fr_123';
        $senderId = 'user1';
        $receiverId = 'user2';
        $createdAt = new \DateTimeImmutable();

        $pendingRequest = new FriendRequest(
            id: $requestId,
            senderId: $senderId,
            receiverId: $receiverId,
            status: FriendRequestStatus::PENDING,
            createdAt: $createdAt
        );

        $this->friendRequestRepository->method('findById')
            ->with($requestId)
            ->willReturn($pendingRequest);

        $this->friendRequestRepository->expects($this->once())
            ->method('save')
            ->with($this->callback(function (FriendRequest $request) use ($requestId, $senderId, $receiverId, $createdAt) {
                return $request->getId() === $requestId
                    && $request->getSenderId() === $senderId
                    && $request->getReceiverId() === $receiverId
                    && $request->getStatus() === FriendRequestStatus::ACCEPTED
                    && $request->getCreatedAt() === $createdAt
                    && $request->getUpdatedAt() !== null;
            }));

        $result = $this->friendshipService->acceptFriendRequest($requestId);

        $this->assertInstanceOf(FriendRequest::class, $result);
        $this->assertSame(FriendRequestStatus::ACCEPTED, $result->getStatus());
    }

    public function testAcceptFriendRequestNotFound(): void
    {
        $requestId = 'fr_nonexistent';

        $this->friendRequestRepository->method('findById')
            ->with($requestId)
            ->willReturn(null);

        $this->expectException(\RuntimeException::class);
        $this->expectExceptionMessage('Friend request not found');

        $this->friendshipService->acceptFriendRequest($requestId);
    }

    public function testAcceptFriendRequestNotPending(): void
    {
        $requestId = 'fr_123';
        $senderId = 'user1';
        $receiverId = 'user2';
        $createdAt = new \DateTimeImmutable();

        $acceptedRequest = new FriendRequest(
            id: $requestId,
            senderId: $senderId,
            receiverId: $receiverId,
            status: FriendRequestStatus::ACCEPTED,
            createdAt: $createdAt,
            updatedAt: new \DateTimeImmutable()
        );

        $this->friendRequestRepository->method('findById')
            ->with($requestId)
            ->willReturn($acceptedRequest);

        $this->expectException(\RuntimeException::class);
        $this->expectExceptionMessage('Friend request is not pending');

        $this->friendshipService->acceptFriendRequest($requestId);
    }

    public function testRejectFriendRequestSuccess(): void
    {
        $requestId = 'fr_123';
        $senderId = 'user1';
        $receiverId = 'user2';
        $createdAt = new \DateTimeImmutable();

        $pendingRequest = new FriendRequest(
            id: $requestId,
            senderId: $senderId,
            receiverId: $receiverId,
            status: FriendRequestStatus::PENDING,
            createdAt: $createdAt
        );

        $this->friendRequestRepository->method('findById')
            ->with($requestId)
            ->willReturn($pendingRequest);

        $this->friendRequestRepository->expects($this->once())
            ->method('save')
            ->with($this->callback(function (FriendRequest $request) use ($requestId, $senderId, $receiverId, $createdAt) {
                return $request->getId() === $requestId
                    && $request->getSenderId() === $senderId
                    && $request->getReceiverId() === $receiverId
                    && $request->getStatus() === FriendRequestStatus::REJECTED
                    && $request->getCreatedAt() === $createdAt
                    && $request->getUpdatedAt() !== null;
            }));

        $result = $this->friendshipService->rejectFriendRequest($requestId);

        $this->assertInstanceOf(FriendRequest::class, $result);
        $this->assertSame(FriendRequestStatus::REJECTED, $result->getStatus());
    }

    public function testRejectFriendRequestNotFound(): void
    {
        $requestId = 'fr_nonexistent';

        $this->friendRequestRepository->method('findById')
            ->with($requestId)
            ->willReturn(null);

        $this->expectException(\RuntimeException::class);
        $this->expectExceptionMessage('Friend request not found');

        $this->friendshipService->rejectFriendRequest($requestId);
    }

    public function testRejectFriendRequestNotPending(): void
    {
        $requestId = 'fr_123';
        $senderId = 'user1';
        $receiverId = 'user2';
        $createdAt = new \DateTimeImmutable();

        $rejectedRequest = new FriendRequest(
            id: $requestId,
            senderId: $senderId,
