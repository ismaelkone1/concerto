declare(strict_types=1);

namespace App\Domain\Service;

use App\Domain\Entity\FriendRequest;
use App\Domain\Entity\FriendRequestStatus;
use App\Domain\Repository\FriendRequestRepositoryInterface;
use DateTimeImmutable;

class FriendshipService
{
    public function __construct(
        private readonly FriendRequestRepositoryInterface $friendRequestRepository
    ) {
    }

    public function sendFriendRequest(string $senderId, string $receiverId): FriendRequest
    {
        // Vérifier si une demande existe déjà
        $existingRequest = $this->friendRequestRepository->findBySenderId($senderId);
        foreach ($existingRequest as $request) {
            if ($request->getReceiverId() === $receiverId && $request->getStatus() === FriendRequestStatus::PENDING) {
                throw new \RuntimeException('Friend request already sent');
            }
        }

        // Vérifier si une demande inverse existe
        $inverseRequests = $this->friendRequestRepository->findBySenderId($receiverId);
        foreach ($inverseRequests as $request) {
            if ($request->getReceiverId() === $senderId && $request->getStatus() === FriendRequestStatus::PENDING) {
                throw new \RuntimeException('Friend request already received from this user');
            }
        }

        $friendRequest = new FriendRequest(
            id: uniqid('fr_', true),
            senderId: $senderId,
            receiverId: $receiverId,
            status: FriendRequestStatus::PENDING,
            createdAt: new DateTimeImmutable()
        );

        $this->friendRequestRepository->save($friendRequest);

        return $friendRequest;
    }

    public function acceptFriendRequest(string $requestId): FriendRequest
    {
        $friendRequest = $this->friendRequestRepository->findById($requestId);
        if ($friendRequest === null) {
            throw new \RuntimeException('Friend request not found');
        }

        if ($friendRequest->getStatus() !== FriendRequestStatus::PENDING) {
            throw new \RuntimeException('Friend request is not pending');
        }

        // Créer une nouvelle instance avec le statut ACCEPTED
        $acceptedRequest = new FriendRequest(
            id: $friendRequest->getId(),
            senderId: $friendRequest->getSenderId(),
            receiverId: $friendRequest->getReceiverId(),
            status: FriendRequestStatus::ACCEPTED,
            createdAt: $friendRequest->getCreatedAt(),
            updatedAt: new DateTimeImmutable()
        );

        $this->friendRequestRepository->save($acceptedRequest);

        return $acceptedRequest;
    }

    public function rejectFriendRequest(string $requestId): FriendRequest
    {
        $friendRequest = $this->friendRequestRepository->findById($requestId);
        if ($friendRequest === null) {
            throw new \RuntimeException('Friend request not found');
        }

        if ($friendRequest->getStatus() !== FriendRequestStatus::PENDING) {
            throw new \RuntimeException('Friend request is not pending');
        }

        $rejectedRequest = new FriendRequest(
            id: $friendRequest->getId(),
            senderId: $friendRequest->getSenderId(),
            receiverId: $friendRequest->getReceiverId(),
            status: FriendRequestStatus::REJECTED,
            createdAt: $friendRequest->getCreatedAt(),
            updatedAt: new DateTimeImmutable()
        );

        $this->friendRequestRepository->save($rejectedRequest);

        return $rejectedRequest;
    }

    public function getPendingRequestsForUser(string $userId): array
    {
        return $this->friendRequestRepository->findPendingByReceiverId($userId);
    }
}</arg>
</fn>
