declare(strict_types=1);

namespace App\Infrastructure\Api\Controller;

use App\Application\UseCase\AcceptFriendRequestUseCase;
use App\Application\UseCase\GetPendingFriendRequestsUseCase;
use App\Application\UseCase\RejectFriendRequestUseCase;
use App\Application\UseCase\SendFriendRequestUseCase;
use Symfony\Bundle\FrameworkBundle\Controller\AbstractController;
use Symfony\Component\HttpFoundation\JsonResponse;
use Symfony\Component\HttpFoundation\Request;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\Routing\Attribute\Route;

#[Route('/api/social')]
class FriendRequestController extends AbstractController
{
    #[Route('/friend-requests', name: 'send_friend_request', methods: ['POST'])]
    public function sendFriendRequest(
        Request $request,
        SendFriendRequestUseCase $useCase
    ): JsonResponse {
        $data = json_decode($request->getContent(), true);

        if (!isset($data['sender_id']) || !isset($data['receiver_id'])) {
            return $this->json(
                ['error' => 'Missing required fields: sender_id, receiver_id'],
                Response::HTTP_BAD_REQUEST
            );
        }

        try {
            $result = $useCase->execute($data['sender_id'], $data['receiver_id']);
            return $this->json($result, Response::HTTP_CREATED);
        } catch (\RuntimeException $e) {
            return $this->json(['error' => $e->getMessage()], Response::HTTP_CONFLICT);
        }
    }

    #[Route('/friend-requests/{id}/accept', name: 'accept_friend_request', methods: ['POST'])]
    public function acceptFriendRequest(
        string $id,
        AcceptFriendRequestUseCase $useCase
    ): JsonResponse {
        try {
            $result = $useCase->execute($id);
            return $this->json($result);
        } catch (\RuntimeException $e) {
            return $this->json(['error' => $e->getMessage()], Response::HTTP_NOT_FOUND);
        }
    }

    #[Route('/friend-requests/{id}/reject', name: 'reject_friend_request', methods: ['POST'])]
    public function rejectFriendRequest(
        string $id,
        RejectFriendRequestUseCase $useCase
    ): JsonResponse {
        try {
            $result = $useCase->execute($id);
            return $this->json($result);
        } catch (\RuntimeException $e) {
            return $this->json(['error' => $e->getMessage()], Response::HTTP_NOT_FOUND);
        }
    }

    #[Route('/friend-requests/pending/{userId}', name: 'get_pending_requests', methods: ['GET'])]
    public function getPendingRequests(
        string $userId,
        GetPendingFriendRequestsUseCase $useCase
    ): JsonResponse {
        $result = $useCase->execute($userId);
        return $this->json($result);
    }
}</arg>
</fn>
