declare(strict_types=1);

namespace App\Tests\Domain\Service;

use App\Domain\Entity\FriendRequest;
use App\Domain\Entity\FriendRequestStatus;
use App\Domain\Repository\FriendRequestRepositoryInterface;
use App\Domain\Service\FriendshipService;
use PHPUnit\Framework\MockObject\MockObject;
use PHPUnit\Framework\TestCase;

class FriendshipServiceTest extends TestCase
{
    private FriendRequestRepositoryInterface&MockObject $friendRequestRepository;
    private FriendshipService $friendshipService;

    protected function setUp(): void
    {
        $this->friendRequestRepository = $this->createMock(FriendRequestRepositoryInterface::class);
        $this->friendshipService = new FriendshipService($this->friendRequestRepository);
    }

    public function testSendFriendRequestSuccess(): void
    {
        $senderId = 'user1';
        $receiverId = 'user2';

        $this->friendRequestRepository->method('findBySenderId')
            ->willReturn([]);

        $this->friendRequestRepository->expects($this->once())
            ->method('save');

        $result = $this->friendshipService->sendFriendRequest($senderId, $receiverId);

        $this->assertInstanceOf(FriendRequest::class, $result);
        $this->assertSame($senderId, $result->getSenderId());
        $this->assertSame($receiverId, $result->getReceiverId());
        $this->assertSame(FriendRequestStatus::PENDING, $result->getStatus());
    }

    public function testSendFriendRequestAlreadySent(): void
    {
        $senderId = 'user1';
        $receiverId = 'user2';

        $existingRequest = new FriendRequest(
            id: 'fr_existing',
            senderId: $senderId,
            receiverId: $receiverId,
            status: FriendRequestStatus::PENDING,
            createdAt: new \DateTimeImmutable()
        );

        $this->friendRequestRepository->method('findBySenderId')
            ->with($senderId)
            ->willReturn([$existingRequest]);

        $this->expectException(\RuntimeException::class);
        $this->friendshipService->sendFriendRequest($senderId, $receiverId);
    }

    public function testAcceptFriendRequestSuccess(): void
    {
        $requestId = 'fr_123';
        $pendingRequest = new FriendRequest(
            id: $requestId,
            senderId: 'user1',
            receiverId: 'user2',
            status: FriendRequestStatus::PENDING,
            createdAt: new \DateTimeImmutable()
        );

        $this->friendRequestRepository->method('findById')
            ->willReturn($pendingRequest);

        $this->friendRequestRepository->expects($this->once())
            ->method('save');

        $result = $this->friendshipService->acceptFriendRequest($requestId);

        $this->assertSame(FriendRequestStatus::ACCEPTED, $result->getStatus());
    }

    public function testAcceptFriendRequestNotFound(): void
    {
        $this->friendRequestRepository->method('findById')
            ->willReturn(null);

        $this->expectException(\RuntimeException::class);
        $this->friendshipService->acceptFriendRequest('fr_nonexistent');
    }

    public function testRejectFriendRequestSuccess(): void
    {
        $requestId = 'fr_123';
        $pendingRequest = new FriendRequest(
            id: $requestId,
            senderId: 'user1',
            receiverId: 'user2',
            status: FriendRequestStatus::PENDING,
            createdAt: new \DateTimeImmutable()
        );

        $this->friendRequestRepository->method('findById')
            ->willReturn($pendingRequest);

        $result = $this->friendshipService->rejectFriendRequest($requestId);

        $this->assertSame(FriendRequestStatus::REJECTED, $result->getStatus());
    }

    public function testGetPendingRequestsForUser(): void
    {
        $pendingRequests = [
            new FriendRequest('fr_1', 'user2', 'user1', FriendRequestStatus::PENDING, new \DateTimeImmutable()),
        ];

        $this->friendRequestRepository->method('findPendingByReceiverId')
            ->willReturn($pendingRequests);

        $result = $this->friendshipService->getPendingRequestsForUser('user1');

        $this->assertCount(1, $result);
    }
}</arg>
