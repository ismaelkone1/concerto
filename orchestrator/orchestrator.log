declare(strict_types=1);

namespace App\Infrastructure\Persistence\Repository;

use App\Domain\Entity\FriendRequest;
use App\Domain\Repository\FriendRequestRepositoryInterface;
use App\Infrastructure\Persistence\Entity\FriendRequestDoctrineEntity;
use App\Infrastructure\Persistence\Mapper\FriendRequestMapper;
use Doctrine\Bundle\DoctrineBundle\Repository\ServiceEntityRepository;
use Doctrine\Persistence\ManagerRegistry;

class FriendRequestRepository extends ServiceEntityRepository implements FriendRequestRepositoryInterface
{
    private FriendRequestMapper $mapper;

    public function __construct(ManagerRegistry $registry, FriendRequestMapper $mapper)
    {
        parent::__construct($registry, FriendRequestDoctrineEntity::class);
        $this->mapper = $mapper;
    }

    public function save(FriendRequest $friendRequest): void
    {
        $entity = $this->mapper->toDoctrine($friendRequest);
        $this->getEntityManager()->persist($entity);
        $this->getEntityManager()->flush();
    }

    public function findById(string $id): ?FriendRequest
    {
        $entity = $this->find($id);
        if ($entity === null) {
            return null;
        }

        return $this->mapper->toDomain($entity);
    }

    public function findBySenderId(string $senderId): array
    {
        $entities = $this->findBy(['senderId' => $senderId]);
        return array_map(fn(FriendRequestDoctrineEntity $entity) => $this->mapper->toDomain($entity), $entities);
    }

    public function findByReceiverId(string $receiverId): array
    {
        $entities = $this->findBy(['receiverId' => $receiverId]);
        return array_map(fn(FriendRequestDoctrineEntity $entity) => $this->mapper->toDomain($entity), $entities);
    }

    public function findPendingByReceiverId(string $receiverId): array
    {
        $entities = $this->findBy(['receiverId' => $receiverId, 'status' => \App\Domain\Entity\FriendRequestStatus::PENDING]);
        return array_map(fn(FriendRequestDoctrineEntity $entity) => $this->mapper->toDomain($entity), $entities);
    }

    public function delete(string $id): void
    {
        $entity = $this->find($id);
        if ($entity !== null) {
            $this->getEntityManager()->remove($entity);
            $this->getEntityManager()->flush();
        }
    }
}</arg>
</fn>
