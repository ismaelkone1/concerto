declare(strict_types=1);

namespace App\Application\UseCase;

use App\Domain\Service\FriendshipService;

class GetPendingFriendRequestsUseCase
{
    public function __construct(
        private readonly FriendshipService $friendshipService
    ) {
    }

    public function execute(string $userId): array
    {
        $pendingRequests = $this->friendshipService->getPendingRequestsForUser($userId);

        $result = [];
        foreach ($pendingRequests as $request) {
            $result[] = [
                'id' => $request->getId(),
                'sender_id' => $request->getSenderId(),
                'receiver_id' => $request->getReceiverId(),
                'status' => $request->getStatus()->value,
                'created_at' => $request->getCreatedAt()->format('Y-m-d H:i:s'),
            ];
        }

        return $result;
    }
}</arg>
