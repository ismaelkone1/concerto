# Mimo API key
AI_API_KEY=your_api_key_here

# Discord webhooks
# Webhook for orchestrator status, feature readiness, and blocking errors
DISCORD_WEBHOOK_URL_STATUS=https://discord.com/api/webhooks/your_status_webhook
# Webhook for questions and clarifications before coding
DISCORD_WEBHOOK_URL_QUESTIONS=https://discord.com/api/webhooks/your_questions_webhook
# Webhook for CI/CD pipeline results and test status
DISCORD_WEBHOOK_URL_CICD=https://discord.com/api/webhooks/your_cicd_webhook

# Git remote and project settings
GIT_REMOTE=origin
GIT_DEFAULT_BRANCH=main

# GitHub integration
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=owner/repo
# Optional: GitHub Actions workflow file name or ID
GITHUB_WORKFLOW=ci.yml
