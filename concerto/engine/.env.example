# Clé API pour le service IA (obligatoire)
# Obtenir une clé sur https://platform.openai.com/api-keys ou équivalent
AI_API_KEY=your_api_key_here

# Chemin vers la racine du projet à gérer (optionnel)
# Défaut : répertoire parent de engine/
PROJECT_ROOT=../

# Niveau de logs (debug, info, warn, error)
LOG_LEVEL=info

# Port pour le dashboard (optionnel)
DASHBOARD_PORT=3500